<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 选择并展平 Windows x64 的 NuGet 原生资产。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Directory.Build.props 评估最早，此时 Configuration 默认值尚未由 SDK 设置，需先兜底再计算 pivot，
         否则不带 -c 的命令行构建会拿不到 Configuration，回退成 SDK 默认的 debug_win-x64。 -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- 项目固定为单一 RID，输出目录只按配置区分。 -->
    <ArtifactsPivots>$(Configuration.ToLowerInvariant())</ArtifactsPivots>
    <DefineConstants>$(DefineConstants);MAPPERLY_ABSTRACTIONS_SCOPE_RUNTIME</DefineConstants>

    <!-- WPF 编译会派生出随机名的 *_wpftmp 临时项目；它若同样走 ArtifactsPath，
         会在 .artifacts\bin 下为每次构建留下一个空壳目录。排除后其输出回落到 obj 下随中间文件一起管理。
         （EndsWith 必须先落到属性里再判断：Condition 的解析器不接受属性函数参数里的引号。） -->
    <IsWpfTemporaryProject>$(MSBuildProjectName.EndsWith('_wpftmp'))</IsWpfTemporaryProject>
    <ArtifactsPath Condition="'$(IsWpfTemporaryProject)' != 'true'">$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>

  </PropertyGroup>
  <!-- Ramdisk -->
  <PropertyGroup Condition="Exists('R:\')">
    <BaseIntermediateOutputPath>$([System.IO.Path]::Combine('R:\Projects', '$(MSBuildProjectDirectory.Replace(':', ''))', '.artifacts', 'obj'))\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>