<UserControl
    x:Class="ShiJing.Views.SubPages.TopModules.Video"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:ShiJing.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ShiJing.Views.SubPages.TopModules"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:ShiJing.ViewModels.Videos"
    d:DataContext="{d:DesignInstance Type=vm:VideoViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="59,10,50,0"
            Orientation="Horizontal">
            <ui:AutoSuggestBox
                Grid.Row="0"
                Width="300"
                HorizontalAlignment="Left"
                PlaceholderText="搜索视频文件名称、标签...">
                <behaviors:Interaction.Triggers>
                    <behaviors:EventTrigger EventName="QuerySubmitted">
                        <behaviors:InvokeCommandAction Command="{Binding SearchCommand}" EventArgsParameterPath="QueryText" />
                    </behaviors:EventTrigger>
                </behaviors:Interaction.Triggers>
                <ui:AutoSuggestBox.QueryIcon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                </ui:AutoSuggestBox.QueryIcon>
            </ui:AutoSuggestBox>

            <Button
                Margin="12,0,0,0"
                Command="{Binding OpenFolderCommand}"
                Content="打开文件夹" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="59,10,50,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:TabRadioUserControl GroupName="VideoSortGroup" Options="{Binding SortOptions}" />


        </Grid>
    </Grid>
</UserControl>
