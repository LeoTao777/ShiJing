<UserControl
    x:Class="ShiJing.Views.Controls.VideoCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ShiJing.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    MinWidth="160"
    Background="Transparent"
    Focusable="False"
    mc:Ignorable="d">
    <Border
        Background="White"
        BorderBrush="#E5EAF1"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="7">
        <!--<Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            --><!--  第一部分：缩略图和时长  --><!--
            <Grid
                Grid.Row="0"
                Height="112"
                ClipToBounds="True">

                <Image Source="{Binding Video.Thumbnail, ElementName=Root}" Stretch="UniformToFill" />

                --><!--  无缩略图时显示占位背景  --><!--
                <Border Background="#EEF2F7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Video.Thumbnail, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#94A3B8"
                        Text="VIDEO" />
                </Border>

                --><!--  时长标签  --><!--
                <Border
                    Margin="0,0,6,6"
                    Padding="5,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#CC111827"
                    CornerRadius="3">

                    <TextBlock
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="{Binding Video.DurationText, ElementName=Root}" />
                </Border>
            </Grid>

            --><!--  第二部分：文件信息  --><!--
            <Grid Grid.Row="1" Margin="8,7,5,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#1F2937"
                        Text="{Binding Video.FileName, ElementName=Root}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Video.FilePath, ElementName=Root}" />

                    --><!--  更多操作  --><!--
                    <Button
                        Grid.Column="1"
                        Width="22"
                        Height="22"
                        Margin="3,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="⋮"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#64748B"
                        ToolTip="更多操作">

                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding OpenFolderCommand, ElementName=Root}"
                                    CommandParameter="{Binding Video, ElementName=Root}"
                                    Header="打开文件位置" />

                                <MenuItem
                                    Command="{Binding RemoveCommand, ElementName=Root}"
                                    CommandParameter="{Binding Video, ElementName=Root}"
                                    Header="删除记录" />
                            </ContextMenu>
                        </Button.ContextMenu>

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.ContextMenuService>
                            <ContextMenuService />
                        </Button.ContextMenuService>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    --><!--  修改日期  --><!--
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,5,0"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="▦" />

                        <TextBlock
                            FontSize="10"
                            Foreground="#94A3B8"
                            Text="{Binding Video.ModifiedTime, ElementName=Root, StringFormat={}{0:yyyy-MM-dd}}" />
                    </StackPanel>

                    --><!--  文件大小  --><!--
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,4,0"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="▤" />

                        <TextBlock
                            FontSize="10"
                            Foreground="#94A3B8"
                            Text="{Binding Video.FileSize, ElementName=Root}" />
                    </StackPanel>
                </Grid>
            </Grid>


        </Grid>-->
    </Border>
</UserControl>
